---
import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";
import OgTags from "../components/OgTags.astro";
import Socials from "../components/Socials.astro";
import "../styles/global.css";
import type { ImageMetadata } from "astro";

interface Props {
  pageTitle?: string;
  pageDescription?: string;
  pageImage?: ImageMetadata;
  multiLineHeader?: boolean;
  hideHeaderLogo?: boolean;
  mainWidth?: string;
}

const {
  multiLineHeader,
  hideHeaderLogo,
  mainWidth,
  pageTitle = "The Fujoshi Guide to Web Development – Fully funded on Kickstarter",
  pageDescription,
  pageImage,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <OgTags description={pageDescription} title={pageTitle} image={pageImage} />
    <link rel="stylesheet" href="https://use.typekit.net/exd6spk.css" />
    <ClientRouter />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <script
      is:inline
      defer
      data-domain="fujoweb.dev"
      src="https://plausible.io/js/script.js"></script>
  </head>
  <body style={mainWidth ? `--main-width: ${mainWidth}` : undefined}>
    <div class="learn-site-banner">
      <div class="banner-text">
        <span class="longer-text"
          >Want to learn to use a Terminal (and beyond)?&nbsp;</span
        >Find free guides at&nbsp;<a href="https://learn.fujoweb.dev/"
          >learn.fujoweb.dev</a
        >, now in beta!
      </div>
    </div>
    <Header multiLine={multiLineHeader} showLogo={!hideHeaderLogo} />
    <main>
      <slot />
      <Socials />
    </main>
    <style>
      .learn-site-banner {
        background-color: rgb(70, 66, 88);
        color: white;
        padding-block: 12px;
        padding-inline: 20px;
        width: 100vw;
        margin-top: -20px;
        display: flex;
        justify-content: center;
        text-align: center;
        font-size: 0.9rem;
        text-wrap: balance;
      }
      @media (max-width: 768px) {
        .learn-site-banner .longer-text {
          display: none;
        }
      }
    </style>
  </body>
</html>
