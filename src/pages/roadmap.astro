---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import SalesSignupDialog from "../components/SalesSignupDialog.astro";
import RoadmapGraph from "../features/roadmap/RoadmapGraph.astro";
import slugify from "slugify";
import ogCard from "../images/og-cards/roadmap.png";

const entries = await getCollection("roadmap");
const anchors = entries.map((entry) => slugify(entry.id));
const milestones = entries.map(({ data }, index) => ({
  ...data,
  anchor: anchors[index],
}));
---

<PageLayout
  multiLineHeader
  hideHeaderLogo
  mainWidth="1200px"
  pageTitle="Roadmap - The Fujoshi Guide to Web Development"
  pageDescription="Where each issue of The Fujoshi Guide to Web Development stands, git log style."
  pageImage={ogCard}
>
  <RoadmapGraph
    milestones={milestones}
    title="The Roadmap"
    intro="From our Kickstarter, to your digital (and physical) inboxes, discover where FujoGuide is currently at and where it's going!"
  />

  <div class="contact-container">
    <section class="contact-card" id="roadmap-contact">
      <h2>Want your own copy?</h2>
      <p>
        <strong>Want to be there when each of these commits lands?</strong> Follow
        along on <a
          href="https://www.kickstarter.com/projects/essential-randomness/the-fujoshi-guide-to-web-development/posts"
          >Kickstarter updates</a
        > or check out <a href="/volume-0">Volume 0</a> for the full details on each
        issue.
      </p>
      <button class="signup-button" type="button" data-open-sales-signup>
        Join the waiting list
      </button>
    </section>
  </div>
  <SalesSignupDialog />
</PageLayout>

<style>
  .contact-container {
    container: roadmap-contact / inline-size;
    width: 100%;
    max-width: 700px;
  }

  .contact-card {
    width: 100%;
    max-width: 700px;
    padding: 20px 35px;
    border: 2px solid var(--terminal-dark);
    border-radius: 16px;
    background-color: white;
    box-shadow: 6px 6px 0 0 var(--fujo-red);
  }

  .contact-card h2 {
    font-size: 2.2rem;
  }

  .contact-card > p {
    text-wrap: pretty;
  }

  .signup-button {
    min-height: 44px;
    margin-top: 20px;
    padding: 8px 18px;
    border: 2px solid var(--terminal-dark);
    border-radius: 10px;
    background: var(--terminal-dark);
    color: white;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  .signup-button:hover {
    background: var(--fujo-red);
  }

  .signup-button:focus-visible {
    outline: 2px solid var(--fujo-red);
    outline-offset: 3px;
  }

  @container roadmap-contact (max-width: 450px) {
    .contact-card {
      padding: 16px 20px;
    }

    .contact-card h2 {
      font-size: 1.8rem;
    }
  }
</style>
