  LOGO_TEAL,
  "#8b7bc4",
], (color) => ({
  color,
  glow: `rgba(${[1, 3, 5]
    .map((offset) => parseInt(color.slice(offset, offset + 2), 16))
    .join(", ")}, 0.55)`,
}));

