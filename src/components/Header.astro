---
import Nav from "./Nav.astro";
import SiteLogo from "./SiteLogo.astro";

interface Props {
  multiLine?: boolean;
  showLogo?: boolean;
}

const { showLogo = true, ...props } = Astro.props;
---

<header
  class:list={{
    "single-line": !props.multiLine,
  }}
>
  <Nav />
  {showLogo && <SiteLogo />}
</header>

<style>
  header {
    max-width: var(--header-width);
    margin-bottom: 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  header.single-line {
    display: flex;
    flex-direction: row-reverse;
    flex-wrap: wrap;
    justify-content: center;
  }
  .single-line :global(.logo) {
    width: 400px;
    height: auto;
  }
</style>
