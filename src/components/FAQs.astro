---
import { getCollection, render } from "astro:content";
import { parseInline } from "marked";

const faqs = (
  await getCollection("faqs", ({ data }) => data.type === "character")
).sort((a, b) => a.id.localeCompare(b.id));
const renderedFaqs = await Promise.all(
  faqs.map(async (faq) => ({
    // Drop the ordering prefix ("01-fanworks" -> "faq-fanworks") so links
    // survive reordering.
    anchor: `faq-${faq.id.replace(/^\d+-/, "")}`,
    title: await parseInline(faq.data.title),
    Content: (await render(faq)).Content,
  })),
);
---

{renderedFaqs.map(({ anchor, title, Content }) => (
  <article>
    <details id={anchor}>
      <summary>
        <span class="question" set:html={title} />
        <a class="faq-link" href={`#${anchor}`} aria-label="Link to this question">
          #
        </a>
      </summary>
      <div class="answer">
        <Content />
      </div>
    </details>
  </article>
))}

<script>
  // Arriving on a question's anchor should show its answer, not a closed row.
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id && document.getElementById(id);
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
    }
  };
  // Run once now too: on a fresh load, astro:page-load can fire before this
  // script has registered its listener.
  openFromHash();
  document.addEventListener("astro:page-load", openFromHash);
  window.addEventListener("hashchange", openFromHash);
  // The client router updates same-page hashes with pushState, which doesn't
  // fire hashchange, so the link icon opens its question directly.
  document.addEventListener("click", (event) => {
    const link =
      event.target instanceof Element && event.target.closest(".faq-link");
    if (link) {
      link.closest("details")!.open = true;
    }
  });
</script>

<style>
  article {
    background-color: white;
    border-radius: 10px;
    row-gap: 10px;
    box-shadow: 2px 2px 0px 0px var(--text-color-disabled);
    margin: 0 auto;
    width: 100%;
    border: 2px dashed var(--terminal-dark);
  }

  details {
    width: 100%;
  }

  /* The padding lives on the summary so the whole top of the card toggles,
     not just the title text. */
  summary {
    padding: 25px 30px;
    cursor: pointer;
    font-family: "freude", sans-serif;
    font-weight: 400;
    color: var(--fujo-red);
    font-size: larger;
  }

  /* The global `* { font-family }` reset would otherwise put the title back
     in nunito. */
  .question {
    font-family: inherit;
  }

  details[open] summary {
    padding-bottom: 10px;
  }

  .answer {
    padding: 0 30px 25px;
  }

  .faq-link {
    margin-left: 0.4em;
    color: var(--text-color-disabled);
    font-family: inherit;
    font-weight: inherit;
    text-decoration: none;
    opacity: 0;
  }

  summary:hover .faq-link,
  .faq-link:focus-visible {
    opacity: 1;
  }

  .faq-link:hover {
    color: var(--fujo-pink);
    text-decoration: none;
  }

  article :global(p),
  article :global(ul) {
    line-height: 1.8;
    padding-inline: 10px;
  }
  article :global(ul) {
    margin-top: 1rem;
    padding-left: 1rem;
  }

  article :global(li) {
    margin-left: 20px;
  }

  :global(figure) {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 10px;
    max-width: 100%;
  }

  :global(figure img) {
    min-width: 0;
    width: 50%;
    max-width: 50%;
    height: auto;
  }

  :global(figure.gif) {
    margin-inline: 0;
  }

  :global(figure.gif img) {
    max-width: 80%;
  }

  @media (max-width: 749px) {
    article {
      display: flex;
      flex-direction: column;
      align-content: center;
      align-items: center;
      max-width: 90vw;
    }

    summary {
      padding: 18px 20px;
    }

    .answer {
      padding: 0 20px 18px;
    }

    :global(figure) {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-top: 10px;
      margin-bottom: 10px;
    }

    :global(figure img) {
      width: 100%;
      max-width: 100%;
    }
  }
</style>
