---
interface Props {
  tag: string;
  /** Skip the FujoCoded link + social row, e.g. when the page footer already shows it. */
  hideLinks?: boolean;
}

import Socials from "./Socials.astro";

const { tag, hideLinks = false } = Astro.props;
const emailId = `sales-signup-email-${tag}`;
const descriptionId = `sales-signup-description-${tag}`;
const newsletterTarget = `fujocoded-newsletter-${tag}`;
---

<div class="signup" data-newsletter-option>
  <p id={descriptionId} class="signup-description">
    Join the FujoGuide waiting list and we’ll email you when it’s available to
    buy.
  </p>
  <form
    data-guide-signup
    action={`https://buttondown.com/api/emails/embed-subscribe/fujoguide`}
    method="post"
    target="popupwindow"
    onsubmit="window.open('https://buttondown.com/fujoguide', 'popupwindow')"
  >
    <label class="email-field" for={emailId}>
      <span class="email-label">Email address</span>
      <input
        id={emailId}
        type="email"
        name="email"
        required
        autocomplete="email"
        aria-describedby={descriptionId}
        placeholder="boba-tan@fujocoded.com"
      />
    </label>
    <label class="newsletter-option">
      <input type="checkbox" data-newsletter-opt-in />
      <span>Also send me updates about other FujoCoded projects.</span>
    </label>
    <button type="submit">Join the waiting list</button>
    <input type="hidden" value={tag} name="tag" />
  </form>
  {
    !hideLinks && (
      <div class="signup-links">
        <p>
          <a href="https://fujocoded.com">Visit FujoCoded</a> and follow us
          online.
        </p>
        <Socials socialsOnly />
      </div>
    )
  }
  <form
    hidden
    data-newsletter-signup
    action="https://buttondown.com/api/emails/embed-subscribe/fujocoded"
    method="post"
    target={newsletterTarget}
  >
    <input type="email" name="email" required />
  </form>
  <iframe
    hidden
    name={newsletterTarget}
    title="FujoCoded newsletter subscription response"></iframe>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>(".signup[data-newsletter-option]")
    .forEach((signup) => {
      const guideForm = signup.querySelector<HTMLFormElement>(
        "[data-guide-signup]"
      );
      const guideEmail = guideForm?.querySelector<HTMLInputElement>(
        'input[type="email"]'
      );
      const optIn = signup.querySelector<HTMLInputElement>(
        "[data-newsletter-opt-in]"
      );
      const newsletterForm = signup.querySelector<HTMLFormElement>(
        "[data-newsletter-signup]"
      );
      const newsletterEmail = newsletterForm?.querySelector<HTMLInputElement>(
        'input[type="email"]'
      );

      guideForm?.addEventListener("submit", () => {
        if (!optIn?.checked || !guideEmail?.validity.valid || !newsletterEmail)
          return;
        newsletterEmail.value = guideEmail.value;
        newsletterForm?.requestSubmit();
      });
    });
</script>

<style>
  [data-guide-signup] {
    display: grid;
    gap: var(--signup-form-gap);
    width: min(100%, var(--signup-form-measure));
    margin-block: var(--signup-copy-to-form) 0;
    margin-inline: auto;
    text-align: left;
    --form-color: var(--terminal-dark);
    --radius: 10px;
    font-size: 1em;
  }
  .signup-description {
    margin: 0;
  }
  .signup {
    container-type: inline-size;
    --signup-copy-to-form: 20px;
    --signup-form-gap: 16px;
    --signup-form-measure: 32rem;
    --signup-form-to-follow-up: 32px;
    --signup-follow-up-gap: 12px;
  }
  label {
    display: block;
    line-height: 1.4;
  }
  .email-field {
    display: grid;
    gap: 8px;
  }
  .newsletter-option {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
  }
  .email-label {
    font-weight: 700;
  }
  .newsletter-option input {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    accent-color: var(--fujo-red);
  }
  .signup-links {
    width: min(100%, var(--signup-form-measure));
    margin-inline: auto;
    margin-top: var(--signup-form-to-follow-up);
    text-align: center;
  }
  .signup-links p {
    margin: 0;
  }
  .signup-links a {
    color: var(--terminal-dark);
    text-decoration-color: var(--fujo-red);
    text-decoration-thickness: 2px;
  }
  .signup-links a:hover {
    background: var(--fujo-light-blue);
  }
  .signup-links :global(ul) {
    margin: var(--signup-follow-up-gap) auto 0;
  }
  input,
  button {
    height: 43px;
    font-family: sans-serif;
  }
  .email-field:focus-within input[type="email"] {
    --form-color: var(--fujo-red);
  }
  input[type="email"] {
    width: 100%;
    padding: 7px 15px;
    border-radius: var(--radius);
    border: 2px solid var(--form-color);
    font-size: 15px;
    background-color: var(--fujo-cream);
  }
  input:focus,
  button:focus {
    outline: none;
  }
  button {
    width: 100%;
    min-height: 48px;
    padding-inline: 18px;
    border-radius: var(--radius);
    border: 2px solid var(--form-color);
    background-color: var(--form-color);
    color: white;
    font-weight: bold;
    font-size: 15px;
  }
  button:hover {
    cursor: pointer;
  }
  button:hover,
  button:focus-visible {
    --form-color: var(--fujo-red);
  }
  button:focus-visible {
    outline: 2px solid var(--fujo-red);
    outline-offset: 3px;
  }

  @container (max-width: 23rem) {
    [data-guide-signup] {
      --signup-copy-to-form: 16px;
      --signup-form-gap: 14px;
    }
    .signup-links {
      --signup-form-to-follow-up: 28px;
      --signup-follow-up-gap: 8px;
    }
  }
</style>
